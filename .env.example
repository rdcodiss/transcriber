# Save this file as .env in the same folder as Transcriber.exe or transcriber.py.
# The Provider button configures built-in services from a provider name and an API key.
# Enable one example. Environment variables take precedence over this file.

# OpenAI (default)
OPENAI_API_KEY=your_key_here
# With the default endpoint, auto streams audio and receives partial text via OpenAI Realtime.
# TRANSCRIPTION_MODE=auto

# OpenAI-compatible API
# TRANSCRIPTION_URL=https://provider.example/v1/audio/transcriptions
# TRANSCRIPTION_API_KEY=your_provider_key
# TRANSCRIPTION_FIELDS='{"model":"provider-model"}'

# Deepgram (raw WAV, English example)
# TRANSCRIPTION_URL="https://api.deepgram.com/v1/listen?model=nova-3&language=en"
# TRANSCRIPTION_API_KEY=your_provider_key
# TRANSCRIPTION_AUTH_SCHEME=Token
# TRANSCRIPTION_BODY=wav
# TRANSCRIPTION_RESPONSE_PATH=results.channels.0.alternatives.0.transcript

# Custom API with Base64 audio in a JSON body and an X-API-Key header
# TRANSCRIPTION_URL=https://provider.example/transcribe
# TRANSCRIPTION_API_KEY=your_provider_key
# TRANSCRIPTION_AUTH_HEADER=X-API-Key
# TRANSCRIPTION_AUTH_SCHEME=
# TRANSCRIPTION_BODY=json
# TRANSCRIPTION_FIELDS='{"request":{"audio":"{wav_base64}","language":"en"}}'
# TRANSCRIPTION_RESPONSE_PATH=result.transcript

# Optional settings (see your provider's documentation)
# TRANSCRIPTION_CHUNK_SECONDS=5
# TRANSCRIBER_LAYOUT='Black Bar'
# TRANSCRIBER_HOTKEY=F9
# TRANSCRIBER_CAPTION_OVERLAY=1
# Leave empty to follow the default Windows playback device.
# TRANSCRIBER_OUTPUT_DEVICE=
# TRANSCRIBER_TRANSLATE_TO='Portuguese (Brazil)'
# Optional fallback for translation with audio-only providers.
# TRANSCRIBER_TRANSLATION_API_KEY=your_openai_key_here
# TRANSCRIPTION_METHOD=POST
# TRANSCRIPTION_AUDIO_FIELD=file
# TRANSCRIPTION_HEADERS='{"X-Project-ID":"your-project"}'
# Leave the path blank if the response is plain text.
# TRANSCRIPTION_RESPONSE_PATH=
